---
import { datum, heute, uhrzeit, type Termin, type Veranstaltung } from "../lib/termine";
import { url } from "../lib/url";

interface Props {
  termine: { v: Veranstaltung; t: Termin }[];
}
const { termine } = Astro.props;

const WOCHENTAGE = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"];
const iso = (y: number, m: number, d: number) =>
  `${y}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;

// Termine je Tag
const proTag = new Map<string, typeof termine>();
for (const x of termine) {
  if (!proTag.has(x.t.datum)) proTag.set(x.t.datum, []);
  proTag.get(x.t.datum)!.push(x);
}

// Monate vom aktuellen bis zum Monat des letzten Termins
const [hy, hm] = heute().split("-").map(Number);
const letzter = termine.at(-1)?.t.datum ?? heute();
const [ly, lm] = letzter.split("-").map(Number);
const monate: { y: number; m: number; zellen: (string | null)[] }[] = [];
for (let y = hy, m = hm; y < ly || (y === ly && m <= lm); m === 12 ? (y++, (m = 1)) : m++) {
  const versatz = (new Date(Date.UTC(y, m - 1, 1)).getUTCDay() + 6) % 7; // Montag = 0
  const tage = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const zellen: (string | null)[] = Array(versatz).fill(null);
  for (let d = 1; d <= tage; d++) zellen.push(iso(y, m, d));
  while (zellen.length % 7) zellen.push(null);
  monate.push({ y, m, zellen });
}
---

<div class="kalender" data-kalender>
  {monate.map(({ y, m, zellen }, i) => {
    const titel = `${datum(iso(y, m, 1)).monat} ${y}`;
    return (
      <section class="monat karte" data-monat aria-label={`Kalender ${titel}`}>
        <header>
          <button type="button" class="pfeil" data-zurueck aria-label="Vorheriger Monat" disabled={i === 0} hidden>
            ‹
          </button>
          <h2>{titel}</h2>
          <button type="button" class="pfeil" data-weiter aria-label="Nächster Monat" disabled={i === monate.length - 1} hidden>
            ›
          </button>
        </header>
        <div class="gitter" role="table" aria-label={titel}>
          <div role="row" class="kopfzeile">
            {WOCHENTAGE.map((w) => <span role="columnheader">{w}</span>)}
          </div>
          <div role="rowgroup" class="tage">
            {zellen.map((z) => {
              if (!z) return <span class="tag leer" aria-hidden="true" />;
              const liste = proTag.get(z) ?? [];
              const d = datum(z);
              return (
                <div class:list={["tag", { belegt: liste.length > 0 }]} data-datum={z} role="cell">
                  <span class="nr" aria-label={d.lang}>{d.tag}</span>
                  {liste.map(({ v, t }) => (
                    <a class="eintrag" href={url(`/veranstaltungen/${v.id}`)} aria-label={`${v.data.titel}, ${d.lang}, ${uhrzeit(t)}`}>
                      <span class="zeit">{t.von}</span> <span class="titel">{v.data.titel}</span>
                    </a>
                  ))}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}
</div>

<script>
  for (const k of document.querySelectorAll<HTMLElement>("[data-kalender]")) {
    const monate = [...k.querySelectorAll<HTMLElement>("[data-monat]")];
    let aktiv = 0;
    const zeige = (i: number) => {
      aktiv = Math.max(0, Math.min(monate.length - 1, i));
      monate.forEach((m, j) => (m.hidden = j !== aktiv));
    };
    for (const m of monate) {
      for (const b of m.querySelectorAll<HTMLButtonElement>("[data-zurueck], [data-weiter]")) {
        b.hidden = false;
        b.addEventListener("click", () => {
          zeige(aktiv + (b.hasAttribute("data-weiter") ? 1 : -1));
          monate[aktiv].querySelector<HTMLButtonElement>(b.hasAttribute("data-weiter") ? "[data-weiter]" : "[data-zurueck]")?.focus();
        });
      }
    }
    // Heute markieren, vergangene Tage abblenden (die Seite wird nur nachts neu gebaut)
    const h = new Intl.DateTimeFormat("en-CA", { timeZone: "Europe/Berlin" }).format(new Date());
    for (const t of k.querySelectorAll<HTMLElement>("[data-datum]")) {
      if (t.dataset.datum === h) t.classList.add("heute");
      else if (t.dataset.datum! < h) t.classList.add("vorbei");
    }
    zeige(0);
  }
</script>

<style>
  .kalender {
    margin-bottom: 64px;
  }
  .monat {
    padding: 20px;
  }
  .monat + .monat {
    margin-top: 24px;
  }
  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }
  h2 {
    font-size: 1.3rem;
    margin: 0;
    flex: 1;
    text-align: center;
  }
  .pfeil {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--gruen);
    background: none;
    color: var(--gruen);
    font: inherit;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .pfeil:hover:not(:disabled) {
    background: var(--gruen);
    color: #fff;
  }
  .pfeil:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .kopfzeile,
  .tage {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 6px;
  }
  .kopfzeile {
    margin-bottom: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-leise);
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tag {
    position: relative;
    min-height: 96px;
    padding: 6px;
    border-radius: var(--radius-klein);
    background: var(--hintergrund);
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .tag.leer {
    background: none;
  }
  .tag.vorbei {
    opacity: 0.45;
  }
  .nr {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-leise);
  }
  .heute .nr {
    align-self: flex-start;
    background: var(--akzent);
    color: var(--gruen-dunkel);
    border-radius: 999px;
    padding: 0 8px;
  }
  .belegt {
    background: var(--gruen-hell);
  }
  .eintrag {
    display: block;
    background: var(--gruen);
    color: #fff;
    border-radius: 6px;
    padding: 4px 6px;
    font-size: 0.75rem;
    line-height: 1.3;
    text-decoration: none;
  }
  .titel {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .eintrag:hover,
  .eintrag:focus-visible {
    background: var(--gruen-dunkel);
    color: #fff;
  }
  .zeit {
    font-weight: 600;
    color: var(--akzent);
  }

  /* Handy: nur farbige Markierung, ganzer Tag ist der Link */
  @media (max-width: 700px) {
    .monat {
      padding: 14px 10px;
    }
    .kopfzeile,
    .tage {
      gap: 4px;
    }
    .tag {
      min-height: 0;
      aspect-ratio: 1;
      padding: 4px;
      align-items: center;
      justify-content: center;
    }
    .nr {
      font-size: 0.9rem;
    }
    .belegt {
      background: var(--gruen);
    }
    .belegt .nr {
      color: #fff;
      font-weight: 600;
    }
    .eintrag {
      position: absolute;
      inset: 0;
      padding: 0;
      background: none;
      font-size: 0;
      border-radius: var(--radius-klein);
    }
    .eintrag + .eintrag {
      inset: auto 4px 4px auto;
      width: 8px;
      height: 8px;
      background: var(--akzent);
      border-radius: 50%;
    }
    .eintrag:hover,
    .eintrag:focus-visible {
      background: rgb(255 255 255 / 0.12);
    }
  }
</style>
