---
// Seite für das Netzwerk „CoworkMitte“. Die Adresse steht auf dem Flyer und wird
// auf www.coworking-eic.de/coworkmitte weitergeleitet. Texte von der alten WordPress-Seite.
import { Image } from "astro:assets";
import Seite from "../layouts/Seite.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import { mailto } from "../data/site";
import { url } from "../lib/url";
import heiligenstadt from "../assets/bilder/space-heiligenstadt.jpg";

const spaces = [
  {
    name: "LandErfolg Lenglern",
    ort: "Lenglern bei Göttingen",
    titel: "Coworking mitten im Dorf",
    link: "https://landerfolg-lenglern.de/",
    absaetze: [
      "Der Coworking Space LandErfolg Lenglern bietet Raum zum kreativen Denken, konzentriertem Arbeiten und entspanntem Netzwerken.",
      "Mitten in Lenglerns Landidylle ist Platz für modernes Arbeiten, kreative Meetings und erholsame Pausen unterm Kastanienbaum oder im Obstgarten.",
      "Der Meetingraum im Erdgeschoss und die sechs Arbeitsplätze im Obergeschoss machen den Weg in die Stadt überflüssig. Ihr erreicht den Space mit Bahn und Bus, per Rad und Auto.",
    ],
  },
  {
    name: "FachWork Northeim",
    ort: "Northeim",
    titel: "Vernetzen – Planen – Bilden",
    link: "https://pg-puche.de/fachwork-coworking-space/",
    absaetze: [
      "Der Coworking-Space FachWork Northeim bietet Menschen, die z. B. aus beruflichen Gründen pendeln, die nicht immer am selben Ort arbeiten möchten, die selbstständig oder freiberuflich tätig sind, die Möglichkeit für ein Arbeiten abseits ihres regulären Arbeitsortes.",
      "Wer im Homeoffice arbeitet, kann durch die Arbeit im Coworking-Space eine Trennung zwischen Arbeit und Privatleben schaffen, Pendelnde können Fahrtwege einsparen und branchengleiche oder branchenfremde Arbeitnehmende können sich mit dem Team der planungsgruppe puche austauschen und vernetzen.",
      "Ein angenehmes und gegenseitig inspirierendes Arbeitsklima für alle soll im FachWork unter dem Motto „Vernetzen – Planen – Bilden“ entstehen.",
    ],
  },
  {
    name: "NewKammer Seesen",
    ort: "Seesen",
    titel: "Ein kommunaler Workspace",
    link: "https://www.stadtverwaltung-seesen.de/Wirtschaft/Gr%C3%BCndung-und-Coworking/",
    absaetze: [
      "Die NewKammer ist Seesens zentrale Anlaufstelle für innovatives Arbeiten im ländlichen Raum. Im Coworking Space gibt es moderne Büroarbeitsplätze, also Einzel- und Gruppenschreibtische, einen Besprechungsraum sowie Veranstaltungsflächen für Seminare und Workshops.",
      "Angestellte, Selbstständige, Unternehmen und Startups finden hier einen Ort, an dem sie sich frei entfalten und individuelle wie gemeinschaftliche Projekte agil umsetzen können – auf einer flexiblen Plattform, auf der alle ihre Kompetenzen einbringen und von einem aktiven Netzwerk profitieren.",
    ],
  },
  {
    name: "anSTADTBUERO Uslar",
    ort: "Uslar",
    titel: "Was gibt’s im anSTADTBUERO?",
    link: "https://stadtbue.ro/",
    absaetze: [
      "Ein Ort, der aus der Community entstanden ist. Im Vordergrund stehen die Menschen, die hier arbeiten wollen – als wohnortnahe Alternative zwischen Pendeln und Homeoffice oder als Arbeitsraum auf Reisen.",
      "Eingebettet in die Uslarer Altstadt stehen höhenverstellbare Sitz-Steh-Schreibtische mit Monitoren bereit. Dazu kommen schnelles Internet, ein Besprechungsraum für bis zu 6 Personen, eine kleine Kaffee- und Teeküche sowie eine Sitzecke. Ein bisschen wie zu Hause …",
    ],
  },
];
---

<Seite titel="CoworkMitte" beschreibung="CoworkMitte: fünf Coworking Spaces in Südniedersachsen und Nordthüringen – Lenglern, Northeim, Seesen, Uslar und das Eichsfeld.">
  <Seitenkopf
    kicker="CoworkMitte"
    titel="Fünf Standorte – auch in deiner Nähe"
    text="Entdecke die teilnehmenden Coworking Spaces zwischen Harz, Solling und Eichsfeld. Jeder Space ist eigenständig – hüpf einfach weiter zu dem, der zu dir passt."
  >
    <ul class="sprungmarken">
      {spaces.map((s, i) => <li><a href={`#space-${i + 1}`}>{s.ort}</a></li>)}
      <li><a href="#space-eichsfeld">Eichsfeld</a></li>
    </ul>
  </Seitenkopf>

  <section class="abschnitt abschnitt--weiss">
    <div class="container">
      <div class="spaces">
        {spaces.map((s, i) => (
          <article class="space karte" id={`space-${i + 1}`}>
            <span class="nummer" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <p class="ort">{s.ort}</p>
            <h2>{s.name}</h2>
            <h3>{s.titel}</h3>
            {s.absaetze.map((p) => <p>{p}</p>)}
            <a class="knopf knopf--rahmen" href={s.link} target="_blank" rel="noopener">Zur Website von {s.name} ↗</a>
          </article>
        ))}

        <article class="space space--eichsfeld karte" id="space-eichsfeld">
          <div class="bild-rund eichsfeld-bild">
            <Image src={heiligenstadt} alt="Der Coworking Space in Heiligenstadt" widths={[600, 1000]} sizes="(min-width: 880px) 520px, 100vw" />
          </div>
          <div>
            <span class="nummer" aria-hidden="true">05</span>
            <p class="ort">Heilbad Heiligenstadt und Leinefelde-Worbis</p>
            <h2>Coworking Eichsfeld</h2>
            <h3>Willkommen im Eichsfeld</h3>
            <p>
              Coworking Eichsfeld wurde im Mai 2021 von Menschen gegründet, die sich nach einem inspirierenden und flexiblen Arbeitsort gesehnt haben und den Status quo im Eichsfeld verändern möchten. Ziel ist eine Kultur des Miteinanders, durch die die Potenziale der Region erschlossen und gestärkt werden.
            </p>
            <p>
              An den beiden Standorten in Heilbad Heiligenstadt und Leinefelde-Worbis sind die Spaces eine Anlaufstelle für Digitalisierung, Neues Arbeiten und Innovation. Die Plätze lassen sich flexibel mieten und bieten mit Highspeed-Internet, Drucker, Telefonbox, Gemeinschaftsküche und Besprechungsräumen die perfekte Arbeitsatmosphäre.
            </p>
            <div class="knoepfe">
              <a class="knopf" href={url("/heiligenstadt")}>Heiligenstadt</a>
              <a class="knopf" href={url("/leinefelde")}>Leinefelde</a>
              <a class="knopf knopf--rahmen" href={url("/")}>Zur Startseite</a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="container kopf--mitte frage">
      <span class="kicker">Fragen zu CoworkMitte?</span>
      <h2>Wir freuen uns über deine Nachricht!</h2>
      <div class="knoepfe">
        <a class="knopf knopf--akzent" href={mailto("Frage zu CoworkMitte")}>E-Mail schreiben</a>
      </div>
    </div>
  </section>
</Seite>

<style>
  .sprungmarken {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sprungmarken a {
    display: block;
    padding: 6px 16px;
    border: 1px solid var(--linie);
    border-radius: 999px;
    background: var(--flaeche);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .sprungmarken a:hover {
    background: var(--gruen);
    border-color: var(--gruen);
    color: #fff;
  }

  .spaces {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 880px) {
    .spaces {
      grid-template-columns: 1fr 1fr;
    }
  }
  .space {
    position: relative;
    padding: clamp(24px, 4vw, 36px);
    scroll-margin-top: 100px;
    display: flex;
    flex-direction: column;
  }
  .space .knopf {
    margin-top: auto;
    align-self: flex-start;
  }
  .space > p:last-of-type {
    margin-bottom: 24px;
  }
  .nummer {
    position: absolute;
    top: clamp(20px, 3vw, 30px);
    right: clamp(24px, 4vw, 36px);
    font-size: 2.4rem;
    font-weight: 600;
    line-height: 1;
    color: var(--gruen-hell);
  }
  .ort {
    margin: 0 0 4px;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--akzent);
  }
  .space h2 {
    margin-bottom: 6px;
    padding-right: 3.5rem;
  }
  .space h3 {
    font-size: 1.1rem;
    color: var(--text-leise);
    font-weight: 500;
  }

  .space--eichsfeld {
    background: var(--gruen);
    color: #fff;
    display: grid;
    gap: 28px;
  }
  @media (min-width: 880px) {
    .space--eichsfeld {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1.15fr;
      align-items: center;
    }
  }
  .space--eichsfeld > div {
    position: relative;
  }
  .space--eichsfeld .nummer {
    top: 0;
    right: 0;
    color: rgb(255 255 255 / 0.18);
  }
  .space--eichsfeld h2 {
    color: #fff;
  }
  .space--eichsfeld h3 {
    color: rgb(255 255 255 / 0.75);
  }
  .space--eichsfeld .knopf {
    margin-top: 0;
    background: #fff;
    border-color: #fff;
    color: var(--gruen);
  }
  .space--eichsfeld .knopf--rahmen {
    background: transparent;
    color: #fff;
  }
  .eichsfeld-bild {
    aspect-ratio: 4 / 3;
  }

  .frage {
    text-align: center;
  }
  .frage .knoepfe {
    justify-content: center;
  }
</style>
