---
import Seite from "../layouts/Seite.astro";
import { verein, tel } from "../data/site";
---

<Seite titel="Impressum">
  <section class="abschnitt">
    <div class="container prosa">
      <h1>Impressum</h1>

      <p><strong>Angaben gemäß § 5 DDG</strong></p>
      <p>
        Coworking Eichsfeld e. V.<br />
        Windische Gasse 11A<br />
        37308 Heilbad Heiligenstadt<br />
        Deutschland
      </p>
      <p>
        <strong>Vertreten durch den Vorstand</strong><br />
        Miriam Löffler (Vorstandsvorsitzende), Sandra Simon (stellv. Vorstandsvorsitzende), Hans-Georg Gremler (Schatzmeister)
      </p>
      <p>
        <strong>Kontakt</strong><br />
        Telefon: <a href={tel(verein.telefonZentral)}>{verein.telefonZentral}</a><br />
        E-Mail: <a href={`mailto:${verein.email}`}>{verein.email}</a>
      </p>
      <p>
        <strong>Registereintrag</strong><br />
        Eingetragen im Vereinsregister<br />
        Registergericht: Amtsgericht Heilbad Heiligenstadt<br />
        Registernummer: VR 400597
      </p>
      <p>
        <strong>Umsatzsteuer-Identifikationsnummer</strong> gemäß § 27a Umsatzsteuergesetz:<br />
        DE344978896
      </p>
      <p>
        <strong>Verbraucherstreitbeilegung</strong><br />
        Wir sind nicht bereit und nicht verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
      </p>
      <p>
        <strong>Bildnachweis</strong><br />
        Fotos: Daniel Günther (www.danielguenther.com)
      </p>
    </div>
  </section>
</Seite>

<style>
  .prosa {
    max-width: 78ch;
  }
  h1 {
    margin-bottom: 1em;
  }
</style>
